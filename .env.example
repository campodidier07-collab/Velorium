# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=time_style_relojeria
DB_USER=root
DB_PASS=

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
APP_NAME="Time & Style"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/relojeria-system

# ============================================
# CONFIGURACIÓN DE SESIÓN
# ============================================
SESSION_LIFETIME=7200
SESSION_COOKIE_NAME=timestyle_session

# ============================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================
UPLOAD_MAX_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# ============================================
# CONFIGURACIÓN DE EMAIL (Futuro)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@timestyle.com
MAIL_FROM_NAME="Time & Style"

# ============================================
# CONFIGURACIÓN DE PAGO (Futuro)
# ============================================
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================
CSRF_TOKEN_NAME=csrf_token
HASH_ALGORITHM=bcrypt
PASSWORD_MIN_LENGTH=6

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_LEVEL=debug
LOG_PATH=storage/logs/

# ============================================
# NOTAS
# ============================================
# 1. Copia este archivo a .env y configura tus valores
# 2. NUNCA subas el archivo .env a control de versiones
# 3. Asegúrate de que .env esté en .gitignore
